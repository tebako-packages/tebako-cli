#!/usr/bin/env ruby
# emit_matrix — emit the GitHub Actions build matrix from a feedstock recipe.
# Usage: ruby tools/emit_matrix Tebakofile
# Prints one JSON object: {"include":[{version, platform, runner}, ...]}
# One leg per platform in the recipe (the repackage carries ONE upstream
# version — the recipe's tebako release line). Unknown platforms are a hard
# error (docs/conventions.md).
#
# The runner map: the musl + windows-arm64 legs ride the static tfs CLI
# (musl static runs on the gnu host; the windows-arm64 leg stages on
# windows-11-arm). macos is on the macos-15 generation (macos-14 retired).
# No triplet, runner, or container is named in the workflow — this map is
# the SSOT.

require 'yaml'
require 'json'

RUNNERS = {
  'x86_64-linux-gnu'     => 'ubuntu-24.04',
  'aarch64-linux-gnu'    => 'ubuntu-24.04-arm',
  'x86_64-linux-musl'    => 'ubuntu-24.04',      # the musl tfs CLI links the musl loader — it images in the alpine container on the gnu host
  'aarch64-linux-musl'   => 'ubuntu-24.04',      # CROSS leg: ubuntu-24.04-arm's Alpine container runs no JS actions; the x64 host images the arm64 payload (the payload bytes are data)
  'aarch64-macos'        => 'macos-15',
  'x86_64-macos'         => 'macos-15',
  'x86_64-windows-ucrt'  => 'windows-latest',
  'aarch64-windows-ucrt' => 'windows-11-arm',
}.freeze

abort "usage: ruby tools/emit_matrix RECIPE" unless ARGV[0]
recipe = YAML.load_file(ARGV[0])

version = recipe.dig('upstream', 'version') or abort "emit_matrix: upstream.version missing"
platforms = recipe['platforms'] or abort "emit_matrix: platforms missing"

    legs = platforms.map do |triplet|
  runner = RUNNERS[triplet] or abort "emit_matrix: no runner mapped for platform '#{triplet}'"
  leg = { version: version, platform: triplet, runner: runner }
  # The musl legs run in the alpine container: the musl tfs CLI is not
  # static (it links the musl loader) and cannot execute on the gnu host.
  leg[:container] = 'alpine:3.21' if triplet.include?('-musl')
  # A cross leg's packaged binary cannot execute on the host (the
  # aarch64-musl CLI on an x64 host) — the boot smoke's extract-and-run
  # is skipped there; the stage tool's read-back validation is the leg's
  # proof (the manifest + the entrypoint present). The imager there runs
  # on the HOST's platform (the x64 alpine container), never the
  # payload's.
  if triplet == 'aarch64-linux-musl'
    leg[:cross] = true
    leg[:imager] = 'x86_64-linux-musl'
  end
  leg
end

puts JSON.generate(include: legs)

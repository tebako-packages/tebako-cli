# Feedstock recipe for tebako-cli — the tebako CLI as a tebako payload.
# spec 13 §9 + docs/conventions.md in tebako-packages/index.
#
# This feedstock compiles nothing: it re-packages the tamatebako/tebako
# release's CLI binary into a toolkit payload (kind: toolkit, zero-runtime —
# the binary is the host's own format, the dispatch is spec 03 §2.2's
# zero-runtime entrypoint). The self-hosting arc's self-package: the product
# publishes its own CLI, installable from the public registry.
name: "tebako-cli"
kind: toolkit
summary: "The tebako CLI (press/install/dispatch driver) as a tebako payload — the self-hosting self-package"

# The upstream is the tamatebako/tebako RELEASE (the published CLI binary per
# platform) — the feedstock consumes the product's published artifact, never
# the source (the release-chain law). The version rides the tebako release line.
upstream:
  repo: "tamatebako/tebako"
  release: "v2.8.73"
  version: "2.8.73"

build:
  system: repackage        # download the published binary + image it; no compile
  link_mode: static        # the CLI binary is statically linked by construction
  deps: []                 # no payload deps

# Image tooling (every leg): the tfs CLI from the tamatebako/tebako release —
# `tfs mkimage` is the imager. The asset digests are pinned here (the repo's
# toolchain pin SSOT) and cross-checked against the release's own SHA256SUMS
# at fetch time.
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.79"
  sha256:
    linux-gnu-x86_64: "e7c0280b3582aabdc98dc7f5acaba1e6ecb919f17b661b6e1de037b058fc5041"
    linux-gnu-arm64: "faeb13ce708244abd1e090734b83571d89a087984ecc30fae09758a55a172a0e"
    linux-musl-x86_64: "3ae32b75e83fe839bb554dac7ffc3b96752972f8ae037e7b26203e1d410eda1b"
    linux-musl-arm64: "d5b03c14b0caa1de0e6713023390c46aaacfda9996cbae93c7a8b98ee7d12a1f"
    macos-arm64: "1a92cff237c63b0fe9c99f08301cbd0dd645a44bd1384b5ed6e3302843d45668"
    macos-x86_64: "eaf917f9228f5c102623ea11ff0efa31e3c01d135b8352888f953407892f9ab9"
    windows-ucrt64: "ee77efb4d90fa035247730a4d94df1522b56feae26a6753440edd8d54106381e"
    windows-ucrt-arm64: "e41f6695a7d17292c5e040f5c68494eafaff6d3ff0c5e773419dcece1812e232"

platforms:
  - x86_64-linux-gnu
  - aarch64-linux-gnu
  - x86_64-linux-musl
  - aarch64-linux-musl
  - aarch64-macos
  - x86_64-macos
  - x86_64-windows-ucrt
  - aarch64-windows-ucrt

provides:
  executables:
    # the windows image carries /bin/tebako.exe (stage fills the suffix)
    - {name: "tebako", path: "/bin/tebako", version: "2.8.73"}
  libraries: []
